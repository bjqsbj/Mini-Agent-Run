{
  "name": "mini-agent-run",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18.0"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env server/main.ts",
    "build": "node engine/build.mjs && vite build web --outDir ../dist --emptyOutDir",
    "test": "node --test tests/*.test.mjs",
    "check": "tsc --noEmit"
  },
  "dependencies": {
    "vue": "3.5.22"
  },
  "devDependencies": {
    "@jitl/quickjs-singlefile-cjs-release-sync": "0.32.0",
    "@types/node": "22.18.6",
    "@vitejs/plugin-vue": "5.2.4",
    "esbuild": "0.25.12",
    "fflate": "0.8.3",
    "quickjs-emscripten-core": "0.32.0",
    "typescript": "5.9.3",
    "vite": "6.4.1"
  }
}
